NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://vybe-platform-staging.pages.dev,https://vybe-platform-staging.vercel.app

# Leave DATABASE_URL empty for the no-spend local memory adapter.
DATABASE_URL=
REDIS_URL=

# Use long random values outside local development.
JWT_SECRET=change-me-local-access-secret-64-characters-minimum-in-production
JWT_REFRESH_SECRET=change-me-local-refresh-secret-64-characters-minimum-in-production
BCRYPT_ROUNDS=12

# Raw provider APIs are disabled for VYBE. Claude Code CLI subscription use is separate.
ENABLE_PAID_AI=false
